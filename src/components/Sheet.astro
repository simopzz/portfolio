---
interface Props { id: string; sheet: number; label: string; class?: string }
const { id, sheet, label, class: cls } = Astro.props;
const xs = Array.from({ length: 8 }, (_, i) => i + 1);
const ys = 'ABCDEFGH'.split('');
---
<section class:list={['sheet', cls]} id={id} data-sheet={sheet} aria-label={label}>
  <div class="frame">
    <div class="zones zones-x top" aria-hidden="true">{xs.map((n) => <span>{n}</span>)}</div>
    <div class="zones zones-x bottom" aria-hidden="true">{xs.map((n) => <span>{n}</span>)}</div>
    <div class="zones zones-y left" aria-hidden="true">{ys.map((l) => <span>{l}</span>)}</div>
    <div class="zones zones-y right" aria-hidden="true">{ys.map((l) => <span>{l}</span>)}</div>
    <div class="field">
      <span class="pen pen-t" aria-hidden="true"></span>
      <span class="pen pen-r" aria-hidden="true"></span>
      <span class="pen pen-b" aria-hidden="true"></span>
      <span class="pen pen-l" aria-hidden="true"></span>
      <slot />
    </div>
  </div>
</section>
