---
import { site } from '../site';
import Delta from './Delta.astro';

interface Props {
  sheet: number;
  total: number;
  title: string;
  rev: string;
  date: string;
  /** cover variant: carries role and profile links */
  full?: boolean;
}
const { sheet, total, title, rev, date, full = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class:list={['tb', { 'tb-full': full }]} role="group" aria-label={`Title block, sheet ${pad(sheet)} of ${pad(total)}`}>
  <div class="tb-cell tb-wide">
    <span class="k">Drawn by</span>
    <span class="v tb-name">{site.name}</span>
  </div>
  <div class="tb-cell">
    <span class="k">Sheet</span>
    <span class="v">{pad(sheet)} / {pad(total)}</span>
  </div>
  {full ? (
    <div class="tb-cell tb-span">
      <span class="k">Role</span>
      <span class="v">{site.role}</span>
    </div>
  ) : (
    <div class="tb-cell tb-span">
      <span class="k">Title</span>
      <span class="v">{title}</span>
    </div>
  )}
  <div class="tb-cell tb-span tb-contact">
    <span class="k">Contact</span>
    <span class="v">
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <button class="copy" type="button" data-copy={site.email}>Copy</button>
      <span class="copy-status visually-hidden" role="status"></span>
    </span>
  </div>
  {full && (
    <div class="tb-cell tb-wide">
      <span class="k">Elsewhere</span>
      <span class="v tb-links">
        <a href={site.github} rel="me">GitHub</a>
        <a href={site.linkedin} rel="me">LinkedIn</a>
      </span>
    </div>
  )}
  <div class:list={['tb-cell', { 'tb-wide': !full }]}>
    <span class="k">Rev</span>
    <span class="v tb-rev"><Delta rev={rev} /> {date}</span>
  </div>
  {!full && (
    <div class="tb-cell">
      <span class="k">Scale</span>
      <span class="v">NTS</span>
    </div>
  )}
</div>
