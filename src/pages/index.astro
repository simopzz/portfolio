---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Drawing from '../components/Drawing.astro';
import { site } from '../site';
import { dandori } from '../drawings/dandori';
import { tegakko } from '../drawings/tegakko';
import type { Drawing as DrawingData } from '../drawings/types';

const drawings: Record<string, DrawingData> = { dandori, tegakko };
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
const host = (href: string) => href.replace('https://', '');
// a different highlighter per project title, in page order
const marks = ['hl-p', 'hl-t'];
---
<Base>
  <svg width="0" height="0" aria-hidden="true" style="position: absolute">
    <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="4" /></filter>
    <filter id="rough-sm"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="9" /><feDisplacementMap in="SourceGraphic" scale="2.2" /></filter>
  </svg>

  <main>
    <header class="hero">
      <h1><span class="hl hl-y">{site.name}</span></h1>
      <p class="role">{site.role}</p>
      <p class="hook">Designs backend systems and ships them end to end. Two of them are sketched below.</p>

      <div class="act">
        <svg class="note-arrow" viewBox="0 0 220 120" aria-hidden="true">
          <path d="M8 22 C70 4 150 18 176 82" />
          <path d="M160 70 L177 86 L186 64" />
        </svg>
        <p class="aside" aria-hidden="true">quickest way to reach Simone</p>
        <div class="mailbox">
          <svg class="box-line" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M6 8 L394 4 L397 74 L4 77 Z" /></svg>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
          <button class="copy" type="button" data-copy={site.email}>copy</button>
          <span class="visually-hidden" role="status"></span>
        </div>
        <p class="else"><a href={site.github} rel="me">GitHub</a> · <a href={site.linkedin} rel="me">LinkedIn</a></p>
      </div>
    </header>

    <section class="notes" aria-labelledby="notes-h">
      <h2 id="notes-h"><span class="hl hl-t">Things to know</span></h2>
      <ul>
        {site.about.map((n) => (
          <li>
            <svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path class="bx" d="M3 4 L21 3 L20.5 21 L3.5 20.5 Z" /><path class="ck" d="M7 12 L11 16 L19 5" /></svg>
            {n}
          </li>
        ))}
      </ul>
    </section>

    {rendered.map(({ p, Content }, i) => (
      <section class="proj" aria-labelledby={`${p.id}-h`}>
        <div class="proj-head">
          <h2 id={`${p.id}-h`}><span class:list={['hl', marks[i % marks.length]]}>{p.data.title}</span></h2>
          {p.data.kanji && <span class="kanji" lang="ja">{p.data.kanji}</span>}
          <p class="stack">built with: {p.data.stack}</p>
        </div>

        <figure class="panel sketch">
          <Drawing drawing={drawings[p.id]} id={p.id} title={`${p.data.title}: ${p.data.drawingTitle.toLowerCase()} sketch`} />
          <figcaption class="caption">fig. {p.data.drawingTitle.toLowerCase()}</figcaption>
        </figure>

        <div class="text">
          <div class="prose"><Content /></div>
          <ul class="links">
            {p.data.links.map((l) => (
              <li>
                {l.private ? <span class="closed">{l.label}: <s>{host(l.href)}</s></span> : <a href={l.href}>{l.label} <span>{host(l.href)}</span></a>}
                {l.note && <em>({l.note})</em>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <footer class="close">
      <h2>Write to Simone</h2>
      <div class="mailbox">
        <svg class="box-line" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true"><path d="M5 6 L395 9 L393 76 L7 73 Z" /></svg>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy" type="button" data-copy={site.email}>copy</button>
        <span class="visually-hidden" role="status"></span>
      </div>
      <p class="else"><a href={site.github} rel="me">GitHub</a> · <a href={site.linkedin} rel="me">LinkedIn</a></p>
    </footer>
  </main>

  <script>
    // Highlighters swipe, and sketches draw themselves, the first time they scroll into view.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('on');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.3 },
      );
      for (const el of document.querySelectorAll('.hl, .sketch')) {
        el.classList.add('armed');
        io.observe(el);
      }
    }

    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      const status = b.parentElement?.querySelector('[role="status"]');
      let t: number | undefined;
      b.addEventListener('click', async () => {
        let ok = true;
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? '');
        } catch {
          ok = false;
        }
        b.textContent = ok ? 'copied!' : 'copy failed';
        b.classList.toggle('done', ok);
        if (status) status.textContent = ok ? 'Email address copied' : 'Copy failed. Use the email link instead.';
        clearTimeout(t);
        t = window.setTimeout(() => {
          b.textContent = 'copy';
          b.classList.remove('done');
          if (status) status.textContent = '';
        }, 2200);
      });
    }
  </script>
</Base>
